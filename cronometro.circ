      <a name="text" val="DESCRESCENTE"/>
    </comp>
    <comp lib="6" loc="(1770,1255)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="Cresce = 0 =&gt; Crescente"/>
    </comp>
    <comp lib="6" loc="(1775,1275)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="Cresce = 1 =&gt; Decrescente"/>
    </comp>
    <comp lib="6" loc="(1775,355)" name="Text">
      <a name="font" val="SansSerif plain 18"/>
      <a name="text" val="ZERO = 0000"/>
    </comp>
    <comp lib="6" loc="(1780,375)" name="Text">
      <a name="font" val="SansSerif plain 18"/>
      <a name="text" val="NOVE = 1001"/>
    </comp>
    <comp lib="6" loc="(1792,1602)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="Manual = 0 =&gt; CLOCK"/>
    </comp>
    <comp lib="6" loc="(1797,1617)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="Manual = 1 =&gt; Impulso"/>
    </comp>
    <comp lib="6" loc="(1875,615)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="CRESCENTE"/>
    </comp>
    <comp lib="6" loc="(1885,165)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Se é ZERO ou NOVE"/>
    </comp>
    <comp lib="6" loc="(2250,610)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="DESCRESCENTE"/>
    </comp>
    <comp lib="6" loc="(2560,170)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="É crescente e NUM = 9 =&gt; CARRY"/>
    </comp>
    <comp lib="6" loc="(2565,195)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="É decrescente e NUM = 0 =&gt; Borrow"/>
    </comp>
    <comp lib="6" loc="(2725,615)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="CRESCENTE"/>
    </comp>
    <comp lib="6" loc="(2793,2505)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="PINOS do SET"/>
    </comp>
    <comp lib="6" loc="(2900,1660)" name="Text">
      <a name="text" val="Se RESET + Crescente =&gt; volta pra ZERO"/>
    </comp>
    <comp lib="6" loc="(2905,1270)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="Se desligado, mantém o valor de Q, ou seja, não altera"/>
    </comp>
    <comp lib="6" loc="(2915,1680)" name="Text">
      <a name="text" val="Se RESET + Descrescente =&gt; volta pra NOVE"/>
    </comp>
